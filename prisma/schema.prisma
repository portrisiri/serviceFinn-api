// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  userId             Int                  @id @default(autoincrement())
  firstName          String?
  lastName           String?
  email              String               @unique
  password           String?
  phoneNumber        String?
  profilePicture     String?
  rating             Float?
  isActive           Boolean?
  isVerified         Boolean?
  lastLogin          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  booking            Booking[]
  reviewerRating     RatingReview[]       @relation("Reviewer")
  penaltyUser        Penalty[]            @relation("PenaltyUser")
  UserAddress        UserAddress[]
  UserPaymentDetails UserPaymentDetails[]
}

model UserAddress {
  addressId Int     @id @default(autoincrement())
  name      String?
  address   String?
  location  String?
  userId    Int
  user      User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model UserPaymentDetails {
  paymentDetailsId Int    @id @default(autoincrement())
  userId           Int
  user             User   @relation(fields: [userId], references: [userId])
  type             String
}

model Category {
  categoryId   Int
  categoryName String
  subCatId     Int          @id
  subCatName   String
  marketRate   MarketRate[]
  Service      Service[]
}

model Provider {
  providerId                Int            @id @default(autoincrement())
  firstName                 String
  lastName                  String
  email                     String         @unique
  password                  String
  phoneNumber               String
  companyName               String?
  personalVerification      Boolean?       @default(false)
  qualificationVerification Boolean?       @default(false)
  companyVerification       Boolean?       @default(false)
  skills                    String?
  availability              String?
  profilePicture            String?
  providerRating            Float?
  location                  String?
  isActive                  Boolean?
  service                   Service[]
  booking                   Booking[]
  revieweeRating            RatingReview[] @relation("Reviewee")
  penaltyProvider           Penalty[]      @relation("PenaltyProvider")
  Documents                 Documents[]
}

model Service {
  serviceId        Int       @id @default(autoincrement())
  providerId       Int
  categoryId       Int
  serviceName      String
  price            Decimal?
  provider         Provider  @relation(fields: [providerId], references: [providerId])
  booking          Booking[]
  categorySubCatId Int
  Category         Category  @relation(fields: [categorySubCatId], references: [subCatId])
}

model Admin {
  adminId     Int         @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String      @unique
  password    String
  phoneNumber String?
  permissions String
  Documents   Documents[]
}

enum JobStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BookingPaymentStatus {
  PAID
  PENDING
}

model Booking {
  bookingId     Int                  @id @default(autoincrement())
  userId        Int
  providerId    Int
  serviceId     Int
  startDate     DateTime
  endDate       DateTime?
  startTime     DateTime
  endTime       DateTime
  location      String
  jobScope      String?
  status        JobStatus            @default(PENDING)
  bookingDate   DateTime             @default(now())
  paymentStatus BookingPaymentStatus @default(PENDING)
  user          User?                @relation(fields: [userId], references: [userId])
  provider      Provider?            @relation(fields: [providerId], references: [providerId])
  service       Service?             @relation(fields: [serviceId], references: [serviceId])
  ratingReview  RatingReview[]
  bookingPromo  BookingPromo[]
  payment       Payment[]
  penalty       Penalty[]
}

enum ReviewType {
  FORPROVIDER
  FORUSER
}

model RatingReview {
  ratingId    Int        @id @default(autoincrement())
  reviewerId  Int
  revieweeId  Int
  ratingScore Int
  comment     String?
  image       String?
  bookingId   Int
  createdAt   DateTime
  type        ReviewType
  isHidden    Boolean
  reviewer    User?      @relation("Reviewer", fields: [reviewerId], references: [userId])
  reviewee    Provider?  @relation("Reviewee", fields: [revieweeId], references: [providerId])
  booking     Booking?   @relation(fields: [bookingId], references: [bookingId])
}

model BookingPromo {
  bookingId Int
  promoId   Int
  booking   Booking   @relation(fields: [bookingId], references: [bookingId])
  promotion Promotion @relation(fields: [promoId], references: [promotionId])

  @@id([bookingId, promoId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  paymentId     Int           @id @default(autoincrement())
  bookingId     Int
  amount        Decimal
  paymentDate   DateTime
  paymentMethod String?
  paymentStatus PaymentStatus
  transactionId String
  booking       Booking?      @relation(fields: [bookingId], references: [bookingId])
}

model Penalty {
  penaltyId       Int       @id @default(autoincrement())
  bookingId       Int
  userId          Int
  providerId      Int
  reason          String?
  dateApplied     DateTime
  penaltyDuration Int
  expiryDate      DateTime
  booking         Booking?  @relation(fields: [bookingId], references: [bookingId])
  user            User?     @relation("PenaltyUser", fields: [userId], references: [userId])
  provider        Provider? @relation("PenaltyProvider", fields: [providerId], references: [providerId])
}

model Promotion {
  promotionId    Int            @id @default(autoincrement())
  promotionName  String
  description    String?
  startDate      DateTime
  endDate        DateTime
  usageLimit     Int
  discountAmount Decimal
  bookingPromo   BookingPromo[]
}

model MarketRate {
  marketRateId    Int      @id @default(autoincrement())
  categoryId      Int
  min             Decimal
  max             Decimal
  lastScrapedDate DateTime @updatedAt
  subCatId        Int
  subCatName      Category @relation(fields: [subCatId], references: [subCatId])
}

enum DocumentType {
  QUALIFICATION
  COMPANYREGIS
  NATIONALID
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Documents {
  docId      Int            @id @default(autoincrement())
  type       DocumentType
  url        String
  providerId Int
  provider   Provider       @relation(fields: [providerId], references: [providerId], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  approval   ApprovalStatus @default(PENDING)
  adminId    Int?
  admin      Admin?         @relation(fields: [adminId], references: [adminId])
}
